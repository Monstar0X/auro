# --- Telegram (https://my.telegram.org/apps + @BotFather) ---
BOT_TOKEN=
API_ID=
API_HASH=

# --- Hosting ---
# Public HTTPS URL of this service (Mini App must be https). Render/Railway/Heroku give you one.
PUBLIC_URL=https://your-app.onrender.com
# Direct link of the Mini App registered with BotFather (/newapp), WITHOUT ?startapp.
# This is what makes the "Swipe" button work inside groups.  e.g. https://t.me/YourBot/quorum
MINIAPP_LINK=
PORT=8080
DB_PATH=data/quorum.db

# Comma separated Telegram ids that may lock any night (optional)
OWNER_IDS=

# --- Modes ---
# QUORUM_DEMO=1 uses built-in fixtures (no AniList calls). DEV_AUTH=1 lets you test the Mini App in a
# normal browser with ?dev=1:Alice  -  NEVER enable DEV_AUTH in production.
QUORUM_DEMO=0
DEV_AUTH=0
LIST_TTL_HOURS=12
